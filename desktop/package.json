{
  "name": "novyse",
  "version": "1.2.0-20260831.0",
  "description": "A desktop client for Novyse",
  "main": "build/main.js",
  "scripts": {
    "dev": "bun run build && bunx electron .",
    "build": "mkdir -p build-assets/icons && cp ../assets/images/logo-novyse-512.png build-assets/icons/512x512.png && cp ../assets/images/logo.svg build-assets/icons/icon.svg && esbuild src/main.ts --outfile=build/main.js --platform=node --bundle --packages=external --format=cjs && esbuild src/preload.ts --outfile=build/preload.js --platform=node --bundle --packages=external --format=cjs",
    "dist": "electron-builder --config electron-builder.config.ts",
    "postinstall": "bunx electron-rebuild"
  },
  "overrides": {
    "minimatch": "10.2.2"
  },
  "resolutions": {
    "minimatch": "10.2.2"
  },
  "keywords": [
    "messaging",
    "chat",
    "novyse",
    "desktop",
    "electron"
  ],
  "homepage": "https://www.novyse.com",
  "author": {
    "name": "Novyse",
    "email": "contact@novyse.com",
    "url": "https://www.novyse.com"
  },
  "license": "GNU GENERAL PUBLIC LICENSE",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime-types": "^3.0.1",
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "mime-types": "^3.0.2",
    "sharp": "^0.34.5",
    "zxing-wasm": "^3.0.2"
  }
}
