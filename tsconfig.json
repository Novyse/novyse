{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.jsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/index.jsx",
    "src/types/**/*.d.ts",
    "src/context/ThemeContext.tsx",
    "app/_app.js",
    "app/components/Icon.jsx",
    "src/utils/global/Events/EventEmitter.js",
    "src/context/AuthContext.js",
    "src/components/Divider.tsxsx"
  ]
}
